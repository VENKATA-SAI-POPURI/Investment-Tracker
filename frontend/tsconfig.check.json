/* Type-checks every component and template, routed or not (AMENDMENTS A4): `npm run check`. */
{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "noEmit": true
  },
  "files": [
    "src/main.ts"
  ],
  "include": [
    "src/**/*.d.ts",
    "src/app/**/*.ts"
  ],
  "exclude": [
    "src/**/*.spec.ts"
  ]
}
