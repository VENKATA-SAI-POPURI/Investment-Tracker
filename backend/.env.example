# Copy to backend/.env for local development. Never commit the real file.

# Database: leave the TURSO_* lines empty to use a local SQLite file (DATABASE_PATH).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
DATABASE_PATH=investments.db

# Auth
JWT_SECRET=change-me-to-a-long-random-string
GOOGLE_CLIENT_ID=264259769121-grmgud6svdqkbi2o58rsoqmjg6f04cka.apps.googleusercontent.com
# Seeds the first admin on an empty allowlist (fresh installs only)
ADMIN_EMAIL=

# Optional: AI analyst (one of these)
GROQ_API_KEY=
GEMINI_API_KEY=

# Optional: extra allowed browser origins, comma separated
CORS_ORIGINS=
